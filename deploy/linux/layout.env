# 서버 디렉터리·계정·포트 — 셸 스크립트(bootstrap.sh · install_app.sh · verify.sh)가 공통으로 source 한다.
# systemd 유닛(*.service)은 셸 변수를 읽지 못하므로 같은 값을 유닛 파일에 직접 적어 두었다. 바꾸면 두 곳을 함께 고친다.
# 앞에 붙은 환경변수가 있으면 그 값을 쓴다(로컬 시험용: CHEMIP_ROOT=/mnt/e/... bash install_app.sh ...).

CHEMIP_USER="${CHEMIP_USER:-chemip}"
CHEMIP_ROOT="${CHEMIP_ROOT:-/srv/chemip}"
CHEMIP_APP="${CHEMIP_APP:-$CHEMIP_ROOT/app}"
CHEMIP_SHARED="${CHEMIP_SHARED:-$CHEMIP_ROOT/shared}"
CHEMIP_VENV="${CHEMIP_VENV:-$CHEMIP_ROOT/venv}"
CHEMIP_ENV_DIR="${CHEMIP_ENV_DIR:-/etc/chemip}"
CHEMIP_ENV_FILE="${CHEMIP_ENV_FILE:-$CHEMIP_ENV_DIR/chemip.env}"

CHEMIP_BACKEND_PORT="${CHEMIP_BACKEND_PORT:-7011}"
CHEMIP_FRONTEND_PORT="${CHEMIP_FRONTEND_PORT:-7000}"

# Node.js 주 버전(LTS). bootstrap.sh 가 NodeSource 저장소에서 설치한다.
CHEMIP_NODE_MAJOR="${CHEMIP_NODE_MAJOR:-22}"
# 저장소 requirements.txt 중 서버에 깔지 않는 패키지(공백 구분). pyahocorasick 은 특허 색인 빌드 스크립트 전용이고
# Python 3.12 용 휠이 없어 C 컴파일이 필요하므로 런타임 서버에서는 뺀다.
CHEMIP_PIP_SKIP="${CHEMIP_PIP_SKIP:-pyahocorasick}"
# RAM 이 이 값(MiB)보다 작으면 스왑 파일을 만든다.
CHEMIP_SWAP_THRESHOLD_MB="${CHEMIP_SWAP_THRESHOLD_MB:-8000}"
CHEMIP_SWAP_SIZE_GB="${CHEMIP_SWAP_SIZE_GB:-4}"
