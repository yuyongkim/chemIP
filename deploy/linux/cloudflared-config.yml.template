# cloudflared 설정 틀 — 서버의 /etc/cloudflared/config.yml 로 복사해 <...> 두 곳을 채운다.
#
# 서버 전용 터널(예: chemip-cloud)을 새로 만든다. PC 의 기존 터널(chemip, 호스트 25개)의 자격 파일을 서버로 복사하면
# 그 터널의 다른 도메인 트래픽까지 서버로 나뉘어 들어와 404 가 나므로 절대 복사하지 않는다.
# 비밀값(자격 JSON)은 이 파일에 넣지 않는다. 파일 경로만 적는다.

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json
loglevel: info

ingress:
  # 본 주소 — DNS 를 이 터널로 돌리는 순간(README 6단계) 서버가 서비스한다.
  - hostname: chemip.yule.pics
    service: http://127.0.0.1:7000
    originRequest:
      connectTimeout: 30s
      httpHostHeader: chemip.yule.pics
  # 사전 확인용 주소 — 본 주소를 돌리기 전에 서버를 외부에서 시험한다. 전환 후 지워도 된다.
  - hostname: chemip-staging.yule.pics
    service: http://127.0.0.1:7000
    originRequest:
      connectTimeout: 30s
      httpHostHeader: chemip.yule.pics
  - service: http_status:404
