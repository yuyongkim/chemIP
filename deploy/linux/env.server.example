# /etc/chemip/chemip.env — ChemIP 서버 비밀값(소유 root:chemip, 권한 0640).
# 이 틀에는 변수 이름만 있다. 값은 사장님이 Windows 의 G:\MSDS\.env 에서 직접 옮겨 적는다(sync 스크립트는 .env 를 올리지 않는다).
# 경로·포트·CORS·LLM 끄기 같은 비밀 아닌 설정은 chemip-backend.service 의 Environment= 줄에 있다.
# 여기 적은 값은 유닛의 Environment= 보다 우선한다.
# 고친 뒤: sudo systemctl restart chemip-backend

# ---- 필수: MSDS 검색 ----
KOSHA_SERVICE_KEY_DECODED=
KOSHA_SERVICE_KEY_ENCODED=

# ---- 특허 탭(KIPRIS API — 클라우드에서는 특허 색인 DB 없이 이것만 쓴다) ----
KIPRIS_API_KEY=

# ---- 무역·의약품 ----
KOTRA_API_KEY_DECODED=
KOTRA_API_KEY_ENCODED=
DRUG_API_KEY_DECODED=
DRUG_API_KEY_ENCODED=

# ---- 취급 회사(PRTR·유해화학시설) ----
# PC .env 에서는 이름이 "PRTR_API " (공백 포함)와 "유해화학시설_API" 이다.
# systemd 는 공백·한글 이름을 받지 않으므로 아래 이름으로 옮겨 적는다(백엔드는 두 이름 모두 읽는다).
PRTR_ACCESS_KEY=
HAZMAT_FACILITY_API_KEY=

# ---- 뉴스(선택) ----
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 외부 접근 키·요청 게시판 관리자 토큰 ----
CHEMIP_API_KEY=
CHEMIP_ADMIN_TOKEN=

# ---- 선택(PC .env 에 없으면 비워 둔다) ----
TOURISM_API_KEY_DECODED=
PUBMED_API_KEY=
COMPTOX_API_KEY=
