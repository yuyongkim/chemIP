# =========================================================
# ChemIP Platform - Environment Template
# =========================================================
# MINIMAL SETUP: Only KOSHA_SERVICE_KEY_DECODED is needed
# for basic chemical search. All keys are free from data.go.kr.
# Optional components (patent index, LLM) work without keys.
# =========================================================

# -----------------------------
# Public Data API Keys (data.go.kr)
# Get free keys at: https://www.data.go.kr
# -----------------------------
KOSHA_SERVICE_KEY_ENCODED=YOUR_ENCODED_KOSHA_KEY
KOSHA_SERVICE_KEY_DECODED=YOUR_DECODED_KOSHA_KEY
# KOSHA MSDS 호출 경로 순서(쉼표 구분). 기본 = data.go.kr 15157612(msdschem1, 이용허락 "제한 없음").
# datagokr_legacy(구 msdschem)·kosha_direct(msds.kosha.or.kr)는 첫 경로가 실패할 때만 쓰는 대체 경로.
# 이용허락이 확인된 경로만 쓰려면 KOSHA_MSDS_ROUTES=datagokr
# KOSHA_MSDS_ROUTES=datagokr,datagokr_legacy,kosha_direct

KOTRA_API_KEY_ENCODED=YOUR_ENCODED_KOTRA_KEY
KOTRA_API_KEY_DECODED=YOUR_DECODED_KOTRA_KEY

DRUG_API_KEY_ENCODED=YOUR_ENCODED_DRUG_KEY
DRUG_API_KEY_DECODED=YOUR_DECODED_DRUG_KEY
# MFDS 의약품 제품 허가정보(data.go.kr 15095677) 호출 순서. 오류·0건이면 다음 주소를 쓴다.
# MFDS_APPROVAL_URLS=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08/getDrugPrdtPrmsnInq08,https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08/getDrugPrdtPrmsnDtlInq08,https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07/getDrugPrdtPrmsnInq07

# Tourism key (optional: if different from KOTRA key)
TOURISM_API_KEY_DECODED=YOUR_TOURISM_KEY_IF_DIFFERENT

# -----------------------------
# KIPRIS
# -----------------------------
KIPRIS_API_KEY=YOUR_KIPRIS_KEY
# KIPRIS Plus 이용약관 제19조: 한국특허정보원 서면 허락 없이 검색 결과의 제3자 제공·가공 금지.
# KIPRIS_PUBLIC_DISPLAY=false → 특허 탭이 결과 목록 대신 "KIPRIS에서 보기" 링크만 보인다(KIPRIS Plus 호출 안 함).
# KIPRIS_IN_AI=false        → AI 분석 근거에서 KIPRIS 결과를 뺀다(KIPRIS 근거가 담긴 AI 캐시도 무시).
# 기본값 true = 현행 동작. 서면 허락(kiprisplus@kipi.or.kr)을 받기 전 공개 배포라면 둘 다 false 권장.
KIPRIS_PUBLIC_DISPLAY=true
KIPRIS_IN_AI=true

# -----------------------------
# PubMed (optional)
# -----------------------------
PUBMED_API_KEY=YOUR_PUBMED_API_KEY

# -----------------------------
# Naver News API (optional fallback)
# 검색 API 약관: 결과는 "네이버 검색결과" 별도 블록에 원문·원문 링크 그대로 표시, KOTRA 와 섞지 않음,
# AI 입력 금지, 영구 저장 금지(메모리 캐시 10분만 사용).
# -----------------------------
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# -----------------------------
# EPA CompTox (optional — US toxicity data)
# -----------------------------
COMPTOX_API_KEY=YOUR_COMPTOX_API_KEY

# -----------------------------
# Localhost port allocation (Track 3 - ChemIP)
# -----------------------------
FRONTEND_PORT=7000
BACKEND_PORT=7011
BACKEND_ORIGIN=http://127.0.0.1:7011

# -----------------------------
# Endpoint overrides (optional)
# -----------------------------
KOTRA_MARKET_NEWS_URL=https://apis.data.go.kr/B410001/kotra_overseasMarketNews/ovseaMrktNews/ovseaMrktNews
KOTRA_ENTRY_STRATEGY_URL=https://apis.data.go.kr/B410001/entryStrategy/entryStrategy
KOTRA_PRICE_INFO_URL=https://apis.data.go.kr/B410001/priceInfoByNatn/priceInfoByNatn
KOTRA_FRAUD_CASE_URL=https://apis.data.go.kr/B410001/cmmrcFraudCase/cmmrcFraudCase
KOTRA_NATIONAL_INFO_URL=https://apis.data.go.kr/B410001/kotra_nationalInformation/natnInfo/natnInfo
KOTRA_ENTERPRISE_SUCCESS_URL=https://apis.data.go.kr/B410001/compSucsCase/compSucsCase
KOTRA_IMPORT_RESTRICTION_URL=https://apis.data.go.kr/B410001/DS00000128/getDS00000128

TOURISM_KOREAN_URL=https://apis.data.go.kr/B551011/KorPetTourService2/areaBasedList2
TOURISM_ENGLISH_URL=https://apis.data.go.kr/B551011/EngService2/searchFestival2

# -----------------------------
# Path standardization (Design-first)
# -----------------------------
# Relative paths are recommended as defaults.
TERMINOLOGY_DB_PATH=./data/terminology.db
GLOBAL_PATENT_INDEX_DB_PATH=./data/global_patent_index.db
USPTO_INDEX_DB_PATH=./data/uspto_index.db
KOSHA_GUIDE_DATA_DIR=./data/kosha_guide

# -----------------------------
# Runtime stability defaults
# -----------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# -----------------------------
# Local LLM (Ollama)
# -----------------------------
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# -----------------------------
# Hosted LLM API baselines (optional)
# -----------------------------
# Leave API keys unset unless you are intentionally running hosted baselines.
# The paper2 runner uses DeepSeek/OpenAI-compatible APIs when the matching key
# is present; otherwise it can fall back to local Ollama for reproducibility.
LLM_PROVIDER=auto
LLM_API_BASE_URL=
LLM_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Set to 1 only for a deliberate legacy-model comparison before DeepSeek's
# documented deepseek-chat/deepseek-reasoner retirement.
DEEPSEEK_ALLOW_LEGACY_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------
# Logging / CORS
# -----------------------------
LOG_DIR=./logs
LOG_LEVEL_FILE=DEBUG
LOG_LEVEL_CONSOLE=ERROR

CORS_ORIGINS=*

# 요청 게시판 관리자 토큰(헤더 X-Admin-Token). 비워 두면 관리자 수정·삭제 API 는 503
CHEMIP_ADMIN_TOKEN=

# 대만 환경부 개방데이터(data.moenv.gov.tw) api_key — scripts/trade_controls/intl 대만 목록 재수집용(--offline 이면 불필요)
TW_MOENV_API_KEY=
